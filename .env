# REQUIRED: Your private key (DO NOT share this!)
# Get this from your wallet (MetaMask, etc.) - export private key
PRIVATE_KEY="your_wallet_private_key_here"

# OPTIONAL: Verifier address (defaults to your deployer address)
# Leave empty or comment out to use your deployer address
VERIFIER_ADDRESS=""

# OPTIONAL: ERC20 token address (e.g., USDC on Base Sepolia)
# USDC on Base Sepolia: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
# DAI on Base Sepolia: 0x0B2FddeC9C168a7Ca1F867A06b58E41653a5C229
# WETH on Base Sepolia: 0x4200000000000000000000000000000000000006
# Leave empty to deploy without token (configure manually later)
TOKEN_ADDRESS="0x036CbD53842c5426634e7929541eC2318f3dCF7e"
